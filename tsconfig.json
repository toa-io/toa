{
  "compilerOptions": {
    "outDir": "/dev/null",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ESNext",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "strict": true,
    "experimentalDecorators": true,
    "noImplicitOverride": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "**/transpiled"
  ]
}
