{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "toa npm",
    "dock": "docker compose up -d --wait",
    "env": "toa types --quiet && toa env --dev && toa map",
    "start": "pm2 start ecosystem.config.js",
    "restart": "npm run env && pm2 restart ecosystem.config.js",
    "stop": "pm2 delete ecosystem.config.js",
    "sys": "pm2 start ecosystem.config.js --only sys",
    "features": "cucumber-js",
    "typecheck": "tsc"
  },
  "workspaces": [
    "components/*"
  ],
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@toa.io/agent": "{{agent}}",
    "@toa.io/operations": "{{version}}",
    "@toa.io/runtime": "{{version}}",
    "@toa.io/userland": "{{version}}",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
