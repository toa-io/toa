{
  "name": "@toa.io/toa",
  "private": true,
  "description": "Microservice operations distributed runtime",
  "homepage": "https://toa.io",
  "author": {
    "name": "Artem Gurtovoi",
    "url": "https://github.com/temich"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toa-io/toa.git"
  },
  "bugs": {
    "url": "https://github.com/toa-io/toa/issues"
  },
  "workspaces": [
    "runtime/*",
    "connectors/*",
    "extensions/*",
    "libraries/*",
    "operations",
    "userland",
    "types"
  ],
  "engines": {
    "node": ">= 24.0.0"
  },
  "overrides": {
    "js-yaml@^3": "3.15.1",
    "js-yaml@^4": "4.3.1",
    "brace-expansion@^1": "1.1.18",
    "brace-expansion@^2": "2.1.4",
    "brace-expansion@^5": "5.0.9",
    "minimatch@^9": {
      "brace-expansion": "2.1.4"
    },
    "uuid": "11.1.1"
  },
  "bin": {
    "toa": "runtime/runtime/bin/toa"
  },
  "devDependencies": {
    "@commitlint/cli": "19.4.1",
    "@commitlint/config-conventional": "16.2.4",
    "@cucumber/cucumber": "11.3.0",
    "@smithy/protocol-http": "3.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.12.0",
    "@types/randomstring": "1.1.12",
    "clone-deep": "4.0.1",
    "cucumber-tsflow": "4.5.2",
    "dotenv": "17.2.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-config-standard-with-typescript": "43.0.1",
    "eslint-plugin-import": "2.32.0",
    "execa": "5.1.1",
    "husky": "9.1.7",
    "jest": "30.1.3",
    "jest-diff": "30.1.2",
    "knex": "3.1.0",
    "lerna": "9.0.7",
    "mongodb": "7.1.0",
    "randomstring": "1.3.1",
    "testcontainers": "11.5.1",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.3.3"
  },
  "scripts": {
    "prepare": "husky || true",
    "install": "npm run transpile",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "typecheck": "tsc -p tsconfig.features.json",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --roots runtime connectors extensions operations libraries features userland",
    "test:stage": "jest --roots userland/example/stage --testPathIgnorePatterns .*/transpiled/",
    "test:integration": "jest --roots integration --runInBand --testTimeout 180000",
    "features": "cucumber-js -t 'not @skip' && npm run features --workspaces --if-present",
    "test:all": "npm run test && npm run test:integration && npm run test:stage && npm run features",
    "lint": "eslint .",
    "lint:diff": "files=$(git diff --cached --name-only --diff-filter=d -- '*.ts'); [ -z \"$files\" ] || ESLINT_USE_FLAT_CONFIG=false eslint $files",
    "npm:login:local": "npm adduser --registry http://localhost:4873 --auth-type=legacy",
    "version:local": "lerna version --conventional-prerelease --preid local --no-commit-hooks --no-changelog --yes --no-git-tag-version && git commit -am 'chore: local bump' --no-verify",
    "publish:canary": "lerna publish --canary --preid local --registry http://localhost:4873",
    "publish:alpha": "npx lerna publish --conventional-prerelease --preid alpha --dist-tag alpha --no-commit-hooks --no-changelog --yes --message \"ci: %s\" --sign-git-commit",
    "cluster": "chmod +x ./integration/scripts/cluster.sh && ./integration/scripts/cluster.sh",
    "setup": "npm run setup:mongo && docker compose up -d && npm run cluster && npm run publish:local && npm ci && toa deploy ./integration/context",
    "setup:mongo": "openssl rand -base64 756 > ./.mongo-keyfile && chmod 400 ./.mongo-keyfile",
    "ci": "rm -f package-lock.json && rm -rf node_modules && npm exec --workspaces -c \"rm -rf node_modules transpiled\" && npm i",
    "transpile": "lerna run transpile",
    "retranspile": "npm exec --workspaces -c \"rm -rf transpiled\" && npm run transpile",
    "compose": "docker compose rm -f -s -v && docker compose up -d"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/runtime",
      "<rootDir>/connectors",
      "<rootDir>/extensions",
      "<rootDir>/operations",
      "<rootDir>/libraries",
      "<rootDir>/integration",
      "<rootDir>/features",
      "<rootDir>/userland"
    ],
    "testMatch": [
      "**/(*.)+(test).(js|ts)"
    ],
    "testPathIgnorePatterns": [
      ".*/transpiled/",
      "<rootDir>/userland/example/stage",
      "<rootDir>/extensions/introspection/ui"
    ],
    "bail": true
  }
}
