{
  "name": "@toa.io/toa",
  "type": "module",
  "private": true,
  "description": "Microservice operations distributed runtime",
  "homepage": "https://toa.io",
  "author": {
    "name": "Artem Gurtovoi",
    "url": "https://github.com/temich"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toa-io/toa.git"
  },
  "bugs": {
    "url": "https://github.com/toa-io/toa/issues"
  },
  "workspaces": [
    "libraries/openspan",
    "runtime/core",
    "libraries/*",
    "extensions/telemetry",
    "extensions/fetch",
    "extensions/stash",
    "extensions/storages",
    "runtime/*",
    "connectors/*",
    "extensions/*",
    "operations",
    "userland"
  ],
  "engines": {
    "node": ">= 24.0.0"
  },
  "overrides": {
    "js-yaml@^3": "3.15.1",
    "js-yaml@^4": "4.3.2",
    "brace-expansion@^1": "1.1.18",
    "brace-expansion@^2": "2.1.4",
    "brace-expansion@^5": "5.0.9",
    "minimatch@^9": {
      "brace-expansion": "2.1.4"
    },
    "uuid": "14.0.2"
  },
  "bin": {
    "toa": "runtime/runtime/bin/toa"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@cucumber/cucumber": "12.9.0",
    "@types/node": "26.4.1",
    "@types/randomstring": "1.3.0",
    "clone-deep": "4.0.1",
    "cucumber-tsflow": "4.6.1",
    "dotenv": "17.4.2",
    "execa": "10.0.1",
    "fast-glob": "3.3.3",
    "husky": "9.1.7",
    "jest-diff": "30.5.1",
    "js-yaml": "5.4.1",
    "knex": "3.3.0",
    "lerna": "10.0.1",
    "mongodb": "7.6.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "randomstring": "1.3.1",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "scripts": {
    "prepare": "husky || true",
    "postinstall": "npm run transpile",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "typecheck": "tsc -p tsconfig.features.json && tsc -p runtime/core/tsconfig.check.json",
    "test:unit": "node --import tsx --test --experimental-test-module-mocks 'libraries/*/source/**/*.test.ts' 'libraries/*/source/**/*.test.js' 'libraries/*/test/**/*.test.js' 'runtime/*/test/**/*.test.js' 'runtime/*/source/**/*.test.ts' 'connectors/*/test/**/*.test.js' 'connectors/*/source/**/*.test.ts' 'connectors/*/src/**/*.test.js' 'extensions/*/source/**/*.test.ts' 'extensions/*/components/**/source/**/*.test.ts' 'operations/src/**/*.test.js' 'operations/src/**/.*/**/*.test.js' 'userland/stage/test/**/*.test.js' 'features/**/*.test.js'",
    "test:stage": "node --import tsx --test --experimental-test-module-mocks 'userland/example/stage/**/*.test.js'",
    "features": "cucumber-js -t 'not @skip' && npm run features --workspaces --if-present",
    "test:all": "npm run test && npm run test:stage && npm run features",
    "lint": "oxlint",
    "lint:diff": "files=$(git diff --cached --name-only --diff-filter=d -- '*.ts' ':!*.d.ts'); [ -z \"$files\" ] || oxlint $files",
    "version:local": "lerna version --conventional-prerelease --preid local --no-commit-hooks --no-changelog --yes --no-git-tag-version && git commit -am 'chore: local bump' --no-verify",
    "publish:alpha": "npx lerna publish --conventional-prerelease --preid alpha --dist-tag alpha --no-commit-hooks --no-changelog --yes --message \"ci: %s\" --sign-git-commit",
    "setup:mongo": "openssl rand -base64 756 > ./.mongo-keyfile && chmod 400 ./.mongo-keyfile",
    "ci": "rm -f package-lock.json && rm -rf node_modules && npm exec --workspaces -c \"rm -rf node_modules transpiled\" && npm i",
    "types": "node runtime/runtime/bin/toa types -q -c 'runtime/prototype' 'extensions/*/components/*'",
    "transpile": "npm run transpile --workspaces --if-present",
    "posttranspile": "npm run types",
    "retranspile": "npm exec --workspaces -c \"rm -rf transpiled\" && find . -name tsconfig.tsbuildinfo -not -path '*/node_modules/*' -delete && npm run transpile",
    "compose": "docker compose rm -f -s -v && docker compose up -d",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  }
}
