#!/usr/bin/env node

// the file has no extension, so its format is the package's: a module

if (process.argv.includes('--wtf')) {
  const wtf = await import('wtfnode')

  console.debug('wtf enabled')

  // dump each 30 seconds
  setInterval(() => wtf.default.dump(), 10000)
}

await import('@toa.io/cli')
