{
  "name": "@toa.io/extensions.exposition",
  "version": "1.0.0-alpha.271",
  "description": "Toa Exposition",
  "author": "temich <tema.gurtovoy@gmail.com>",
  "homepage": "https://github.com/toa-io/toa#readme",
  "main": "transpiled/index.js",
  "types": "transpiled/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toa-io/toa.git"
  },
  "bugs": {
    "url": "https://github.com/toa-io/toa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "@toa.io/core": "1.0.0-alpha.270",
    "@toa.io/generic": "1.0.0-alpha.254",
    "@toa.io/schemas": "1.0.0-alpha.270",
    "bcryptjs": "3.0.3",
    "content-type": "2.1.0",
    "error-value": "0.4.4",
    "jose": "6.2.10",
    "js-yaml": "5.4.1",
    "lru-cache": "11.5.2",
    "matchacho": "0.6.0",
    "minimatch": "10.2.6",
    "msgpackr": "2.1.0",
    "negotiator": "1.1.0",
    "openspan": "1.0.0-alpha.270",
    "paseto": "3.1.4"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "transpile": "tsc && npm run transpile:bans && npm run transpile:basic && npm run transpile:tokens && npm run transpile:roles && npm run transpile:federation && npm run transpile:credentials && npm run transpile:keys && npm run transpile:passkeys && npm run transpile:otp",
    "transpile:bans": "tsc -p ./components/identity.bans",
    "transpile:basic": "tsc -p ./components/identity.basic",
    "transpile:tokens": "tsc -p ./components/identity.tokens",
    "transpile:roles": "tsc -p ./components/identity.roles",
    "transpile:federation": "tsc -p ./components/identity.federation",
    "transpile:credentials": "tsc -p ./components/identity.credentials",
    "transpile:keys": "tsc -p ./components/identity.keys",
    "transpile:passkeys": "tsc -p ./components/identity.passkeys",
    "transpile:otp": "tsc -p ./components/identity.otp",
    "features": "cucumber-js",
    "features:security": "cucumber-js --tags @security",
    "features:octets": "cucumber-js features/octets.*"
  },
  "devDependencies": {
    "@toa.io/extensions.storages": "*",
    "@types/cors": "2.8.19",
    "@types/negotiator": "0.6.5",
    "jest-esbuild": "0.4.0"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "jest-esbuild"
    },
    "testEnvironment": "node"
  },
  "gitHead": "2ab75e1fd23f2e64720a60b8562dda606aa723ee"
}
