{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "printWidth": 90,
  "quoteProps": "as-needed",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "useTabs": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "*.yaml",
    "*.yml",
    "*.json",
    "**/types/toa.d.ts",
    "extensions/introspection/ui",
    "extensions/configuration/ui",
    "extensions/exposition/ui"
  ]
}
